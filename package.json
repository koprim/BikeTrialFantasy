{
  "name": "biketrialfantasy",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:int": "node scripts/with-supabase-env.js jest -c jest.integration.config.js",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:seed": "node scripts/gen-dev-seed.js",
    "build:seed": "node scripts/build-seed.js",
    "build:sql-seed": "node scripts/build-sql-seed.js",
    "build:edge": "node scripts/build-edge.js",
    "functions:serve": "npm run build:edge && supabase functions serve --env-file supabase/functions/.env",
    "functions:deploy": "npm run build:edge && supabase functions deploy",
    "test:functions": "node scripts/with-supabase-env.js jest -c jest.functions.config.js",
    "verify:all": "npm run lint && npm run format:check && jest --silent && npm run test:int -- --silent && npm run test:functions -- --silent && expo export --platform web --output-dir dist",
    "sim:economy": "node scripts/sim-economy.js",
    "sonar:up": "docker compose -f tools/sonarqube/docker-compose.yml up -d",
    "sonar:down": "docker compose -f tools/sonarqube/docker-compose.yml down",
    "sonar": "node scripts/sonar.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@supabase/supabase-js": "2.119.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-localization": "~58.0.5",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "i18next": "^27.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "9.1.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "3.3.3",
    "react-test-renderer": "19.3.0",
    "supabase": "3.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod": "^4.6.6"
    }
  },
  "private": true
}
